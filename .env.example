# Copy to .env and fill in, then run:
#   flutter run -d macos --dart-define-from-file=.env
# Only PUBLIC identifiers belong here. Desktop binaries can be inspected, so
# never put confidential server secrets in this file. See docs/authentication.md.

# Google "Desktop app" OAuth client ID (enables "Sign in with Google").
GOOGLE_CLIENT_ID=

# Optional. Google documents the installed-app secret as non-confidential.
# Leave empty when AUTH_BACKEND_URL is set (recommended).
GOOGLE_DESKTOP_CLIENT_SECRET=

# Optional backend that performs the Google code exchange server-side.
AUTH_BACKEND_URL=

# GitHub OAuth App (or GitHub App) client ID with Device Flow enabled.
GITHUB_CLIENT_ID=

# Space-separated scopes. "repo" is needed to sync to private repositories;
# use "read:user public_repo" to limit access to public repositories.
GITHUB_SCOPES=read:user repo

# Reserved for a future Vesper cloud backend.
API_BASE_URL=

# Supabase project for account-based cloud sync (Project Settings → API Keys).
# The anon / publishable key is public; never put the service_role key here.
SUPABASE_URL=
SUPABASE_ANON_KEY=
